# Search results — regenerated on every run, never worth committing
output/*
!output/.gitkeep
*.csv

# Real SAS logs must not leave the estate; samples/ holds sanitised ones only.
# Leading slash anchors to the repo root, so samples/logs/ is untouched.
/logs/
*.log
!samples/logs/*.log

# Editor / OS noise
.vscode/
*.swp
Thumbs.db
desktop.ini
